<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="792.8" prefWidth="1536.0" styleClass="background" stylesheets="@styles/hanoiTower.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hanoi.towerofhanoi.controllers.HanoiController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Pane fx:id="pane" maxHeight="670.0" maxWidth="600.0" prefHeight="670.0" prefWidth="600.0">
            
               <Rectangle fx:id="tower1" height="360.0" layoutX="95.0" layoutY="288.0" width="10.0" />
               <Rectangle fx:id="tower2" height="360.0" layoutX="295.0" layoutY="288.0" width="10.0" />
               <Rectangle fx:id="tower3" height="360.0" layoutX="495.0" layoutY="288.0" width="10.0" />
            
               <VBox fx:id="vbox1" alignment="BOTTOM_CENTER" layoutX="20.0" layoutY="288.0" prefHeight="360.0" prefWidth="160.0" />
               <VBox fx:id="vbox2" alignment="BOTTOM_CENTER" layoutX="220.0" layoutY="288.0" prefHeight="360.0" prefWidth="160.0" />
               <VBox fx:id="vbox3" alignment="BOTTOM_CENTER" layoutX="420.0" layoutY="288.0" prefHeight="360.0" prefWidth="160.0" />
            
               <Button fx:id="undoButton" layoutX="254.0" layoutY="147.0" mnemonicParsing="false" onAction="#undo" text="◁">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Button fx:id="redoButton" layoutX="306.0" layoutY="147.0" mnemonicParsing="false" onAction="#redo" text="▷">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Button fx:id="solveButton" layoutX="30.0" layoutY="147.0" mnemonicParsing="false" onAction="#autoSolve" text="Solve">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Button layoutX="506.0" layoutY="147.0" mnemonicParsing="false" onAction="#handleReset" text="Reset">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
            
               <Button fx:id="handleHome" layoutX="41.0" layoutY="29.0" mnemonicParsing="false" onAction="#handleHome" prefHeight="50.0" prefWidth="50.0" styleClass="home-button" text="🏠">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Button fx:id="login" layoutX="519.0" layoutY="33.0" mnemonicParsing="false" onAction="#handleLogin" text="👤">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
               <Label fx:id="timeLabel" alignment="CENTER" layoutX="225.0" layoutY="41.0" prefHeight="27.0" prefWidth="150.0" textFill="WHITE">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="moveNumLabel" alignment="CENTER" layoutX="275.0" layoutY="88.0" prefWidth="50.0" textFill="WHITE">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
            
            </Pane>
         </children>
      </StackPane>
   </children>
</AnchorPane>
