<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="792.8" prefWidth="1536.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hanoi.towerofhanoi.controllers.EndGameController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" stylesheets="@styles/endGame.css">
                <children>
                    <Label styleClass="title-label" text="Game Over!">
                        <VBox.margin>
                            <Insets bottom="10.0" top="20.0" />
                        </VBox.margin>
                    </Label>
            
                    <HBox alignment="CENTER" spacing="10.0">
                        <Label fx:id="star1" styleClass="star-label" text="★" />
                        <Label fx:id="star2" styleClass="star-label" text="☆" />
                        <Label fx:id="star3" styleClass="star-label" text="☆" />
                    </HBox>
                  <HBox alignment="CENTER">
                     <children>
                  
                          <Label styleClass="info-label" text="Time:" />
                        <Label fx:id="timeLabel" layoutX="284.0" layoutY="10.0" styleClass="info-label" text="00:00:000" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER">
                     <children>
                          <Label styleClass="info-label" text="Moves:" />
                        <Label fx:id="movesLabel" layoutX="277.0" layoutY="10.0" styleClass="info-label" text="0" />
                     </children>
                  </HBox>
            
                    <HBox alignment="CENTER" spacing="20.0" styleClass="button-container">
                        <Button fx:id="newGameButton" onAction="#newGame" styleClass="newgame-button" text="New Game" />
                        <Button fx:id="menuButton" onAction="#handleHome" prefWidth="114.4" styleClass="menu-button" text="Menu" />
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                    </HBox>
                </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
