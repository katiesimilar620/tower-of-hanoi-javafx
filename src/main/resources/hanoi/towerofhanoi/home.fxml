<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="homePane" prefHeight="792.8" prefWidth="1536.0" stylesheets="@styles/home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hanoi.towerofhanoi.controllers.HomeController">
    <VBox alignment="CENTER" spacing="20.0">
        <Text styleClass="title-label" text="Hanoi Tower">
            <font>
                <Font size="36.0" />
            </font>
        </Text>
        <Button fx:id="login" onAction="#handleLogin" styleClass="login-button" text="👤" />
        <Button fx:id="resume" styleClass="inactive-button" text="Resume" />
        <Button onAction="#newGame" styleClass="active-button" text="New Game" />
      <Button fx:id="saveGame" layoutX="242.0" layoutY="424.0" styleClass="inactive-button" text="save Game" />
        <Button fx:id="loadGame" styleClass="inactive-button" text="Load Game" />
    </VBox>
</StackPane>
